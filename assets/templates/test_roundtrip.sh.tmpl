#!/bin/sh
# Round-trip for {{NAME}}: write one through the API, read it back both as
# the list (GET /api/{{NAME}}) and as the single row (GET /api/{{NAME}}/:id),
# demand it in both.
# Rendered from assets/templates/test_roundtrip.sh.tmpl.
python3 serve.py --port {{PORT}} >/dev/null 2>&1 &
SRV=$!
i=0
while [ $i -lt 40 ]; do
  python3 -c 'import socket,sys; s=socket.socket(); sys.exit(0 if s.connect_ex(("127.0.0.1",{{PORT}}))==0 else 1)' && break
  i=$((i+1))
  sleep 0.2
done
out=$(python3 - <<'PYEOF'
import json, urllib.request
BASE = "http://127.0.0.1:{{PORT}}/api/{{NAME}}"
body = json.dumps({{SAMPLE_JSON}}).encode()
req = urllib.request.Request(BASE, data=body, method="POST")
created = json.loads(urllib.request.urlopen(req).read().decode())
rid = created.get("id")

got_list = urllib.request.urlopen(BASE).read().decode()
in_list = {{NEEDLE}} in got_list

got_one = urllib.request.urlopen(BASE + "/" + str(rid)).read().decode()
in_one = {{NEEDLE}} in got_one

print(in_list and in_one)
PYEOF
)
kill $SRV 2>/dev/null
[ "$out" = "True" ] || { echo "{{NAME}} round trip failed: $out"; exit 1; }
echo "{{NAME}} round trip ok (GET /api/{{NAME}} and GET /api/{{NAME}}/:id both showed it)"
